# Start with AWS Deep Learning Container. See
# https://github.com/aws/deep-learning-containers/blob/master/available_images.md
FROM 763104351884.dkr.ecr.us-east-1.amazonaws.com/tensorflow-training:2.19.0-gpu-py312-cu125-ubuntu22.04-sagemaker

LABEL maintainer="Amazon Braket"
LABEL major_version="1"

ARG PIP=pip3
ARG PYTHON=python3.12

ENV PIP_RETRIES=10 \
    PIP_DEFAULT_TIMEOUT=60

# Patch OS packages: libtiff5/libtiffxx5 (CVE-2025-61144), libssl3/openssl
# (CVE-2026-31789), ca-certificates (current CA roots). ffmpeg + libav*/libsw*
# (CVE-2024-35366/35367/35368) have no jammy community fix and are purged
# since hybrid jobs do not need them.
RUN apt-get update \
 && apt-get install -y --only-upgrade --no-install-recommends \
        libtiff5 \
        libtiffxx5 \
        libssl3 \
        openssl \
 && apt-get install -y --no-install-recommends ca-certificates curl \
 && update-ca-certificates \
 && apt-get purge -y --auto-remove \
        ffmpeg \
        'libavcodec*' \
        'libavformat*' \
        'libavutil*' \
        'libswresample*' \
        'libswscale*' \
        'libavfilter*' \
        'libavdevice*' \
 && rm -rf /var/lib/apt/lists/* \
 && apt-get clean

# Install the patched pip wheel without trusting the existing pip CA bundle.
RUN curl -fsSL https://files.pythonhosted.org/packages/3f/06/3e4420302363fbb71be3c7f35ce042f54bfca330e3e66b3a2e3c4cca579f/pip-26.2.2-py3-none-any.whl -o /tmp/pip-26.2.2-py3-none-any.whl \
 && echo "fd7f4dfa8190e014013b9f08f3e973f4e4c26ffd179a204895533a7254813a70  /tmp/pip-26.2.2-py3-none-any.whl" | sha256sum --check \
 && PYTHONPATH=/tmp/pip-26.2.2-py3-none-any.whl ${PYTHON} -m pip install --no-index --no-deps /tmp/pip-26.2.2-py3-none-any.whl \
 && rm -f /tmp/pip-26.2.2-py3-none-any.whl

# Copy the dependencies file
COPY requirements.txt /
# Installing our custom python libraries
RUN ${PIP} install --no-cache --upgrade -r requirements.txt

# install cuQuantum
RUN wget https://developer.download.nvidia.com/compute/cuquantum/redist/cuquantum/linux-x86_64/cuquantum-linux-x86_64-23.03.0.20-archive.tar.xz && tar xvf ./cuquantum-linux-x86_64-23.03.0.20-archive.tar.xz
RUN mv /cuquantum-linux-x86_64-23.03.0.20-archive /opt/cuquantum

ENV LD_LIBRARY_PATH="/opt/cuquantum/lib:${LD_LIBRARY_PATH}"

# Check compliance
RUN HOME_DIR=/root \
 && curl -o ${HOME_DIR}/oss_compliance.zip https://aws-dlinfra-utilities.s3.amazonaws.com/oss_compliance.zip \
 && unzip ${HOME_DIR}/oss_compliance.zip -d ${HOME_DIR}/ \
 && cp ${HOME_DIR}/oss_compliance/test/testOSSCompliance /usr/local/bin/testOSSCompliance \
 && chmod +x /usr/local/bin/testOSSCompliance \
 && chmod +x ${HOME_DIR}/oss_compliance/generate_oss_compliance.sh \
 && ${HOME_DIR}/oss_compliance/generate_oss_compliance.sh ${HOME_DIR} ${PYTHON} \
 && rm -rf ${HOME_DIR}/oss_compliance*


# Some packages can not be installed using pip (because they are not
# python managed packages) - install them using apt get

# Setup our entry point
COPY braket_container.py /opt/ml/code/braket_container.py

ENV SAGEMAKER_PROGRAM braket_container.py
